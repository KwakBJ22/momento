# ★ 개발과 운영은 **다른 Supabase 프로젝트**다 (docs/ENVIRONMENTS.md 1단계).
#   로컬에서는 반드시 **개발** 프로젝트를 가리킨다. 실제 키는 이 파일에 적지 않는다.
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_DEV_SUPABASE_ANON_KEY

# ★ 카카오는 개발·운영이 **같은 앱**이다(ENVIRONMENTS.md §1) — 같은 값을 쓴다.
#   앱을 새로 만들면 회원번호가 달라져 기존 사용자 연결이 끊긴다(2026-08-06 사고).
VITE_KAKAO_JS_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# 로컬은 백엔드(uvicorn)를 직접 부른다. 배포에서는 비워 두고 Vercel /api 프록시를 쓴다.
VITE_API_BASE_URL=http://localhost:8000
