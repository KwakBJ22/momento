# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=albums

# OpenAI API
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# CORS (쉼표로 구분, Vercel 배포 URL 포함)
CORS_ORIGINS=http://localhost:5173,https://momento-ashen-rho.vercel.app
CORS_ORIGIN_REGEX=https://momento-[a-z0-9-]+-your-team\.vercel\.app

# 공유 카드 링크에 사용할 프론트엔드 주소
FRONTEND_BASE_URL=https://momento-ashen-rho.vercel.app

# Optional
MAX_PHOTOS=10
MAX_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_SIZE_MB=100
