# ★ 개발과 운영은 **다른 Supabase 프로젝트**다 (docs/ENVIRONMENTS.md 1단계).
#   로컬에서는 반드시 **개발** 프로젝트를 가리킨다. 운영 값을 여기에 넣지 않는다.
#     개발  woorialbum-dev  (프로젝트 ref 가 rledlh… 로 시작한다)
#     운영  woorialbum      (Railway 환경변수에만 있다)
#   ★ 실제 키는 이 파일에 적지 않는다. 값은 Supabase 화면에서 각자 받아 `.env` 에 넣는다.
# Supabase
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
# 사진이 들어가는 비공개 버킷. 개발 프로젝트에도 같은 이름으로 만들어 둔다.
SUPABASE_STORAGE_BUCKET=woorialbum-private

# OpenAI API
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# CORS (쉼표로 구분). 로컬만 쓸 때는 localhost 하나면 된다.
CORS_ORIGINS=http://localhost:5173

# 공유 카드 링크에 사용할 프론트엔드 주소. 로컬은 vite dev 주소다.
FRONTEND_BASE_URL=http://localhost:5173

# Platform admin console. Match operators by Supabase Auth user id (primary — works when
# Kakao login provides no email) and/or email (backward compatible). Comma-separated.
PLATFORM_ADMIN_USER_IDS=
PLATFORM_ADMIN_EMAILS=you@example.com

# Optional
MAX_PHOTOS=30
ENABLE_VISION_ANALYSIS=false
MAX_FILE_SIZE_MB=10
MAX_TOTAL_UPLOAD_SIZE_MB=100

# Railway Cron only. Without this value cleanup jobs remain dry-runs.
CLEANUP_EXECUTE=false
